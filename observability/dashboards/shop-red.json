{
  "uid": "shop-red-obi",
  "title": "Shop: RED (OBI, zero-code)",
  "tags": [
    "obi",
    "shop",
    "red"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "30s",
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count{k8s_namespace_name=\"shop\"}, service_name)",
          "refId": "V"
        },
        "definition": "label_values(http_server_request_duration_seconds_count{k8s_namespace_name=\"shop\"}, service_name)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Service map (from OBI application_service_graph metrics)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "nodeGraph",
      "title": "Who calls whom",
      "description": "Edges from traces_service_graph_* metrics that OBI produces. 'incoming' = callers outside the instrumented pods (kubelet health checks). Computed in the browser by Grafana from Prometheus.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 15,
        "h": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "serviceMap",
          "serviceMapQuery": "{client!=\"incoming\", client!~\"obi-poc-.*\"}"
        }
      ]
    },
    {
      "id": 13,
      "type": "table",
      "title": "Edges: calls/s, failed/s (from the same metrics)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 15,
        "y": 1,
        "w": 9,
        "h": 11
      },
      "description": "client -> server pairs from OBI service graph metrics, last 5 min.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "format": "table",
          "instant": true,
          "expr": "sum by (client, server) (rate(traces_service_graph_request_total{client!=\"incoming\", client!~\"obi-poc-.*\"}[5m]))"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "format": "table",
          "instant": true,
          "expr": "sum by (client, server) (rate(traces_service_graph_request_failed_total{client!=\"incoming\", client!~\"obi-poc-.*\"}[5m])) or 0 * sum by (client, server) (rate(traces_service_graph_request_total{client!=\"incoming\", client!~\"obi-poc-.*\"}[5m]))"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "calls/s",
              "Value #B": "failed/s"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "sortBy": [
          {
            "displayName": "calls/s",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 3,
      "type": "row",
      "title": "RED per service (server side, /health excluded)",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Rate: requests per second",
      "description": "R of RED: how many requests each service receives.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 8,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{k8s_namespace_name=\"shop\", service_name=~\"$service\", http_route!=\"/health\"}[1m]))",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Errors: % of requests with 5xx",
      "description": "E of RED. 4xx (e.g. 409 out of stock) are client errors and not counted here.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 13,
        "w": 8,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "100 * (sum by (service_name) (rate(http_server_request_duration_seconds_count{k8s_namespace_name=\"shop\", service_name=~\"$service\", http_route!=\"/health\", http_response_status_code=~\"5..\"}[1m])) or 0 * sum by (service_name) (rate(http_server_request_duration_seconds_count{k8s_namespace_name=\"shop\", service_name=~\"$service\", http_route!=\"/health\"}[1m]))) / sum by (service_name) (rate(http_server_request_duration_seconds_count{k8s_namespace_name=\"shop\", service_name=~\"$service\", http_route!=\"/health\"}[1m]))",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Duration: p95 latency",
      "description": "D of RED: 95% of requests were faster than this.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 13,
        "w": 8,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (service_name, le) (rate(http_server_request_duration_seconds_bucket{k8s_namespace_name=\"shop\", service_name=~\"$service\", http_route!=\"/health\"}[1m])))",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99 for $service",
      "description": "Pick services in the 'service' variable at the top. With All selected, this mixes all services.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{k8s_namespace_name=\"shop\", service_name=~\"$service\", http_route!=\"/health\"}[1m])))",
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{k8s_namespace_name=\"shop\", service_name=~\"$service\", http_route!=\"/health\"}[1m])))",
          "legendFormat": "p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{k8s_namespace_name=\"shop\", service_name=~\"$service\", http_route!=\"/health\"}[1m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Requests per second by status code",
      "description": "200 = ok, 409 = out of stock, 502 = payment failed (orders), 500 = payments error.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (service_name, http_response_status_code) (rate(http_server_request_duration_seconds_count{k8s_namespace_name=\"shop\", service_name=~\"$service\", http_route!=\"/health\"}[1m]))",
          "legendFormat": "{{service_name}} {{http_response_status_code}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "RED per service + route (last 5 min)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (service_name, http_request_method, http_route) (rate(http_server_request_duration_seconds_count{k8s_namespace_name=\"shop\", service_name=~\"$service\", http_route!=\"/health\"}[5m]))",
          "legendFormat": "",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "100 * sum by (service_name, http_request_method, http_route) (rate(http_server_request_duration_seconds_count{k8s_namespace_name=\"shop\", service_name=~\"$service\", http_route!=\"/health\", http_response_status_code=~\"5..\"}[5m])) / sum by (service_name, http_request_method, http_route) (rate(http_server_request_duration_seconds_count{k8s_namespace_name=\"shop\", service_name=~\"$service\", http_route!=\"/health\"}[5m]))",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "histogram_quantile(0.50, sum by (service_name, http_request_method, http_route, le) (rate(http_server_request_duration_seconds_bucket{k8s_namespace_name=\"shop\", service_name=~\"$service\", http_route!=\"/health\"}[5m])))",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D",
          "expr": "histogram_quantile(0.95, sum by (service_name, http_request_method, http_route, le) (rate(http_server_request_duration_seconds_bucket{k8s_namespace_name=\"shop\", service_name=~\"$service\", http_route!=\"/health\"}[5m])))",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "E",
          "expr": "histogram_quantile(0.99, sum by (service_name, http_request_method, http_route, le) (rate(http_server_request_duration_seconds_bucket{k8s_namespace_name=\"shop\", service_name=~\"$service\", http_route!=\"/health\"}[5m])))",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "service_name": "service",
              "http_request_method": "method",
              "http_route": "route",
              "Value #A": "req/s",
              "Value #B": "error % (5xx)",
              "Value #C": "p50",
              "Value #D": "p95",
              "Value #E": "p99"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 3
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p50"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p99"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "req/s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "error % (5xx)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "req/s",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Database calls (decoded from Postgres / Redis wire protocol)",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "DB operations per second",
      "description": "Client side: the app calling the database.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (service_name, db_system_name, db_operation_name) (rate(db_client_operation_duration_seconds_count{k8s_namespace_name=\"shop\", service_name=~\"$service\"}[1m]))",
          "legendFormat": "{{service_name}} \u2192 {{db_system_name}} {{db_operation_name}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "DB p95 latency",
      "description": "How long each DB operation took, seen from the app.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 41,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (service_name, db_system_name, db_operation_name, le) (rate(db_client_operation_duration_seconds_bucket{k8s_namespace_name=\"shop\", service_name=~\"$service\"}[1m])))",
          "legendFormat": "{{service_name}} \u2192 {{db_system_name}} {{db_operation_name}}"
        }
      ]
    }
  ]
}